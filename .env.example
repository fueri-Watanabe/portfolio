# ==============================================================================
# fueri (フエリ) 環境変数設定テンプレート (.env.example)
# Vercel等の本番ホスティング環境では、Project Settings > Environment Variables に登録してください。
# ==============================================================================

# --- お問い合わせメール送信設定 (Nodemailer / Gmail SMTP) ---
# 送信元・通知先となる管理者Gmailアドレス
MAIL_USER=your-email@gmail.com

# Googleアカウントの「2段階認証」設定後に発行できる「アプリパスワード（16文字）」
# ※通常のアカウントログインパスワードではなく、アプリパスワードを入力してください。
# 取得方法: Googleアカウント管理 > セキュリティ > 2段階認証プロセス > アプリ パスワード
MAIL_PASS=xxxx xxxx xxxx xxxx

# --- （参考・将来拡張用）サイト基本設定 ---
NEXT_PUBLIC_SITE_URL=https://fueri.jp
